<ArcGIS defaultAssembly="SmartBuffer.dll" defaultNamespace="SmartBuffer" xmlns="http://schemas.esri.com/DADF/Registry" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.esri.com/DADF/Registry file:///C:/Program%20Files/ArcGIS/Pro/bin/ArcGIS.Desktop.Framework.xsd">
  <AddInInfo id="{407e4c57-0c5d-4c33-b813-12e8aaf09b5a}" version="1.0" desktopVersion="3.5.57366">
    <Name>SmartBuffer</Name>
    <Description>SmartBuffer:  Site-Specific Riparian Shade Protection Buffer Design</Description>
    <Image>Images\AddinDesktop32.png</Image>
    <Author>Kevin Andras</Author>
    <Company>TerrainWorks</Company>
