            <Separator Height="5" Background="Transparent"/>
            <WrapPanel>
            <Label Content="Working Directory:" HorizontalAlignment="Left" Height="26" Width="110" />
            <Separator Width="10" Background="Transparent"/>
            <TextBox x:Name="txtSBDirectory" TextWrapping="Wrap" Text="" Width="400" IsReadOnly="True" Height="19"/>
            </WrapPanel>
            <Separator Height="10" Background="Transparent"/>
            <WrapPanel>
              <Separator Width="10" Background="Transparent"/>
              <Button  ToolTip="Select the NetMap_Files_xx folder."  x:Name="btProgramFiles" Content="Browse" HorizontalAlignment="Left"  VerticalAlignment="Center" Width="69" Click="btProgramFiles_Click_1"/>
              <Separator Width="10" Background="Transparent"/>
              <TextBox  ToolTip="Select the NetMap_Files_xx folder."  x:Name="txtNetMapProgramFiles" HorizontalAlignment="Left" Height="27" TextWrapping="Wrap" Text="Browse to select folder" VerticalAlignment="Top" Width="349"/>


