                </ComboBox>

                <Separator Width="20" Background="Transparent"/>
                <WrapPanel>
                  <Label>Select site tree height</Label>
                  <xctk:DecimalUpDown x:Name="numTreeHt" FormatString="F1" Value="24.0"  Increment=".1"  Maximum="50" Minimum="2" />
                  <Label Content="meters"/>

                </WrapPanel>

              </WrapPanel>

            </StackPanel>

            <StackPanel>
              <Separator Height="5
                                       " Background="Transparent"/>
              <TextBlock TextWrapping="Wrap" Width="600" x:Name="boo2" Text="Using the selected set of reaches, this tool will generate polygons representing the area providing shade." />

              
              <Separator Height="5" Background="Transparent"/>
              <WrapPanel   ToolTip="Output polygons are saved in [dataset folder]\wshd\."  VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Label  Content="Output file name (no spaces or extension):" HorizontalAlignment="Center"/>
                <TextBox   x:Name="txtOutput" TextWrapping="Wrap" Text="" Width="200"/>
              </WrapPanel>
              <Separator Height="5" Background="Transparent"/>
              <Button ToolTip="Generate polygons defining the upstream contributing area to each selected reach.  
                                    Output will have the name provided in the 'Output file name' box, below.  Can take 1 to 20 
                                    minutes, depending on dataset size and quantity of points."  
                                    x:Name="cmdMakeShadeSheds" Content="Go" Width="121" Click="go_Click" HorizontalAlignment="Center"  VerticalAlignment="Center"/>



            </StackPanel>

          </StackPanel>

        </TabItem>

