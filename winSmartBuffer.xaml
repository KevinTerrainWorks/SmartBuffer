                  <Button ToolTip="If you've loaded a stream layer since opening this window, click here to refresh the list."  x:Name="cmdRefreshReach" Content="Refresh" Width="69" Click="cmdRefreshReach_Click"  HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                </WrapPanel>
                <WrapPanel >
                  <Separator Width="10" Background="Transparent"/>

                  <Label>Zone</Label>

                  <Separator Width="10" Background="Transparent"/>
                <ComboBox x:Name="cboLat" Width="100">
                </ComboBox>

                </WrapPanel>
              </WrapPanel>
              <Separator Height="10" Background="Transparent"/>
