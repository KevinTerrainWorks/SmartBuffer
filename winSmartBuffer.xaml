          </TabItem.Header>
          <StackPanel>
            <TextBlock TextAlignment="Center" TextWrapping="Wrap" Margin="0,20,0,0"   >This will list all existing shapefiles from shadeshed analyses.</TextBlock>
            <ListBox x:Name="lstLayers" Margin="0,10,0,0" Height="150" Width="400" SelectionMode="Multiple" />

            <Button ToolTip="Loads selected layers, if not already loaded."  x:Name="cmdLoad"  HorizontalAlignment="Center" Margin="0,10,0,0"  Width="180" Height="30" Click="cmdLoad_Click">
              <TextBlock TextAlignment="Center" TextWrapping="Wrap" >Load Selected Layers</TextBlock>
